# --- Everything dot-prefixed is local tooling (.venv, .claude, .superpowers,
#     .pytest_cache, .env, .vscode, .idea, ...). Re-include the few that must ship.
.*
!.gitignore
!.gitattributes
!.env.example
!.github/

# --- Python ---
__pycache__/
*.pyc
htmlcov/

# --- Node / frontend ---
node_modules/
frontend/dist/
coverage/
npm-debug.log*
yarn-error.log*

# --- SQLite trace databases (incl. WAL sidecar files) ---
*.db
*.db-shm
*.db-wal
*.db-journal

# --- Not shipped with the app (root-anchored: backend/evals/ is source) ---
/Evals/
/Information/
/docs/
/tests/
frontend/src/__tests__/
/pytest.ini
/package-lock.json
/FDE Exam 2.pdf
/airport_agent_architecture.png

# --- Logs ---
*.log

# --- OS ---
Thumbs.db
